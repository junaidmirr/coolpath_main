DEMO_MODE=false

# Supabase Postgres
# Recommended for Render/free deployment: Connect > Transaction pooler.
# Keep this server-side only. Include sslmode=require.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
APP_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
CHECKPOINT_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MODE=transaction

# AI / routing providers
GEMINI_API_KEY=your_google_gemini_api_key
LLM_API_KEY=your_google_gemini_api_key
FORTYGUARD_API_KEY=your_fortyguard_api_key

# Optional voice providers
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=coolpath-transcribe-temp

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=coolpath
